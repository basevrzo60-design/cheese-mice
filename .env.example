# Port exposed by the HTTP and Socket.IO server.
# PORT=3000

# Comma-separated list of approved Socket.IO client origins.
# CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Production environment:
# NODE_ENV=production

# Only when hosting the client separately (set before building the web client):
# VITE_SERVER_URL=https://YOUR-SERVER.onrender.com
